@startuml

package data {
  class BatteryRecord {
    id: Int
    timestamp: Long
    level: Int
    isCharging: Boolean?
    temperature: Int?
    voltage: Int?
  }

  interface BatteryDao {
    + insert(record: BatteryRecord)
    + getSince(from: Long): Flow<List<BatteryRecord>>
    + getLatest(): BatteryRecord?
    + deleteOlderThan(timestamp: Long): Int
  }

  class AppDatabase {
    + batteryDao(): BatteryDao
    + MIGRATION_1_2
  }
}

package util {
  interface BatteryStatusSource {
    + getSnapshot(): BatterySnapshot?
  }
  class BatteryManagerWrapper
  class BatterySnapshot {
    level: Int
    isCharging: Boolean
    temperature: Int?
    voltage: Int?
    chargeStatus: ChargeStatus
    + {static} fromIntent(intent): BatterySnapshot?
  }
  enum ChargeStatus {
    DISCHARGING
    CHARGING
    PLUGGED_NOT_CHARGING
    FULL
  }
  class BatteryReceiver
  class MonitorSettings {
    + highPrecisionEnabled: StateFlow<Boolean>
    + setHighPrecisionEnabled(enabled)
  }
}

package repository {
  class BatteryRepository {
    + getRecordsSince(from): Flow<List<BatteryRecord>>
    + recordBatteryLevel()
    + recordIfChanged(snapshot)
    + deleteExpiredRecords(): Int
  }
}

package domain {
  class DischargeEstimate {
    percentPerHour: Double
    remainingMinutes: Long
    + {static} estimate(records, now): DischargeEstimate?
  }
  class Downsample <<function>> {
    + downsample(records, buckets): List<BatteryRecord>
  }
}

package ui {
  class BatteryViewModel {
    + records: StateFlow<List<BatteryRecord>>
    + period: StateFlow<GraphPeriod>
    + currentStatus: StateFlow<BatterySnapshot?>
    + highPrecisionEnabled: StateFlow<Boolean>
  }
  class BatteryScreen <<Composable>>
  class BatteryGraph <<Composable>>
}

package service {
  class BatteryMonitorService <<ForegroundService>>
  class BootReceiver
}

package worker {
  class BatteryWorker {
    + doWork(): Result
  }
}

class BatteryGraphApplication {
  + repository: BatteryRepository
  + monitorSettings: MonitorSettings
  + batteryStatus: BatteryStatusSource
}

BatteryDao --> BatteryRecord
AppDatabase --> BatteryDao
BatteryManagerWrapper ..|> BatteryStatusSource
BatteryRepository --> BatteryDao
BatteryRepository --> BatteryStatusSource
BatteryReceiver --> BatterySnapshot
BatteryViewModel --> BatteryRepository
BatteryViewModel --> MonitorSettings
BatteryScreen --> BatteryViewModel
BatteryScreen --> BatteryGraph
BatteryScreen --> DischargeEstimate
BatteryGraph --> Downsample
BatteryMonitorService --> BatteryRepository
BatteryMonitorService --> BatteryReceiver
BatteryMonitorService --> MonitorSettings
BootReceiver --> BatteryMonitorService
BatteryWorker --> BatteryRepository
BatteryGraphApplication --> BatteryRepository
BatteryGraphApplication --> MonitorSettings

@enduml
