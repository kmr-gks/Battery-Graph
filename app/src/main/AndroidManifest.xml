<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- WorkManager が自動で追加する権限。ネットワークを条件にした処理は使わないため外す
	     （ストアの権限欄に「ネットワーク接続の表示」と出て、インターネットを使わない説明と矛盾して見えるため） -->
	<uses-permission
		android:name="android.permission.ACCESS_NETWORK_STATE"
		tools:node="remove" />

	<application
		android:name=".BatteryGraphApplication"
		android:allowBackup="true"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:fullBackupContent="@xml/backup_rules"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.BatteryGraph"
		tools:targetApi="31">
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:theme="@style/Theme.BatteryGraph">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />

				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<service
			android:name=".service.BatteryMonitorService"
			android:exported="false"
			android:foregroundServiceType="specialUse">
			<!-- Play Console の申告と合わせる用途の説明 -->
			<property
				android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="Records the battery level each time it changes, at the user's request, and shows the current level in a persistent notification." />
		</service>

		<receiver
			android:name=".service.BootReceiver"
			android:exported="false">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
				<action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
			</intent-filter>
		</receiver>
	</application>

</manifest>